# Secrets
.env

# Python
__pycache__/
*.py[cod]
venv/
.venv/
.pytest_cache/
*.egg-info/

# Data
# Raw pulls and intermediate CSVs stay local: 336 MB, and GitHub blocks >100 MB.
#
# NOTE the star: `data/processed/*`, not `data/processed/`. Git never descends
# into an excluded DIRECTORY, so a `!` negation could never rescue a file inside
# one — the earlier `!data/processed/finding_aggregate.csv` line was dead for
# exactly that reason. Excluding the CONTENTS instead keeps negation possible.
data/raw/
data/processed/*
*.parquet

# Committed by exception. Last matching pattern wins, so these come after.
# crashes.parquet ships so the deployed app has data (16.9 MB, under the 50 MB
# warning). This overrides design decision 16's "one commit after the schema is
# frozen" — a working live URL was judged worth one superseded blob.
!data/processed/crashes.parquet
!data/processed/finding_aggregate.csv

# The cleaning log: 952 bytes of provenance for every number in the README, and
# the artifact CLAUDE.md's year-skew regression test is specified to assert
# against. Without it committed, that test cannot be written at all.
!data/processed/crashes_cleaned_log.json

# OS
.DS_Store
Thumbs.db
.gstack/
