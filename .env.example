# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# NYC Open Data (Socrata) app token. Optional but strongly recommended:
# without one you are throttled hard, and an 848,000-row paginated pull will
# hit rate limits. Register at https://data.cityofnewyork.us/profile/edit/developer_settings
NYC_OPEN_DATA_APP_TOKEN=

# The app itself needs NO secret at runtime. The token is used only by
# scripts/pull_data.py on your machine. Streamlit Community Cloud reads the
# committed Parquet and makes no API calls.
